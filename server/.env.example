# 具身交互智能体
# 服务凭证（App ID / App Secret / Gateway / 形象图）已在「管理后台 → 具身交互智能体」中维护，
# 存入数据库并即时生效，不再通过环境变量下发。
# 供魔珐云端 E2E Server 回调的 brain 代理地址（需公网可达）
AVATAR_PROXY_BASE_URL=

# ASR 语音识别（可选）：由后端随 /api/avatar/config 下发给前端，不再写死在前端源码中。
# 留空则不下发，交由 SDK 使用自身默认 ASR。
ASR_PROVIDER=doubao
ASR_BASE_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
ASR_ACCESS_TOKEN=
ASR_APP_ID=
ASR_RESOURCE_ID=volc.bigasr.sauc.duration

# LLM 默认配置（可通过管理页覆盖）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=<填入>
LLM_MODEL=deepseek-chat

# Embedding（硅基流动 bge-m3）
EMBEDDING_API_KEY=<填入硅基流动 key>
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# 管理页口令
ADMIN_PASSWORD=admin123

# 数据库
DATABASE_URL=sqlite:///./data/app.db

# 加密密钥（32 字节）
ENCRYPTION_KEY=change-me-in-production-32bytes!!
