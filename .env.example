# ============================================
# Docker Compose 一键启动所需的凭证模板
# 使用方式：cp .env.example .env 后填入真实值
# 说明：全部留空也能把整套服务启动起来（用于验证界面与流程），
#       但 LLM 出题/点评、Embedding 检索、具身交互智能体播报会不可用。
# ============================================

# ---------- 具身交互智能体（魔珐星云 XmovAvatar）----------
AVATAR_APP_ID=
AVATAR_APP_SECRET=
AVATAR_GATEWAY_SERVER=https://nebula-agent.xingyun3d.com/user/v1/ttsa_v2/session
# 供魔珐云端 E2E Server 回调的 brain 代理地址（需公网可达，本地调试可留空）
AVATAR_PROXY_BASE_URL=

# ---------- 大模型（OpenAI 兼容协议）----------
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ---------- Embedding（题库向量化）----------
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# ---------- 应用 ----------
# 管理页口令
ADMIN_PASSWORD=admin123
# 敏感配置加密密钥（32 字节，生产环境请替换）
ENCRYPTION_KEY=change-me-in-production-32bytes!!

# ---------- 无凭证运行（可选，二选一）----------
# 1) 离线规则模式：不调用任何模型，用内置题库 + 规则跑通面试主流程（秒级启动）
#    用法：把 OFFLINE_MODE 置为 true 后 `docker compose up -d --build`（无需本地模型）
OFFLINE_MODE=false
# 2) 本地大模型模式：不改这里，改用叠加文件启动（见 README 方式二）
#    docker compose -f docker-compose.yml -f docker-compose.local-llm.yml up -d --build

# ---------- 部署参数（可选）----------
# 前端对外端口
APP_PORT=8080
# PostgreSQL 密码
POSTGRES_PASSWORD=postgres
# pip 镜像源（国内环境加速构建）
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
PIP_TRUSTED_HOST=mirrors.aliyun.com
