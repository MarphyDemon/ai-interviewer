{
  "name": "ai-interviewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:web": "vue-tsc -b && vite build --mode web",
    "build:capacitor": "vue-tsc -b && vite build --mode capacitor",
    "build:miniprogram": "vue-tsc -b && vite build --mode miniprogram",
    "dev:capacitor": "vite --mode capacitor --host 0.0.0.0",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "cap:sync": "npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/camera": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@guolao/vue-monaco-editor": "^1.6.0",
    "@headlessui/vue": "^1.4.1",
    "@xmov/avatar": "^2.0.0-alpha.21",
    "axios": "^1.7.9",
    "marked": "^18.0.9",
    "monaco-editor": "^0.56.0",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.5.0",
    "vue3-lottie": "^3.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@types/node": "^22.10.7",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vue-tsc": "^2.2.0"
  }
}
